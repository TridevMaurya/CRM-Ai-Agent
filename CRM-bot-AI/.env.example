# --- Required ---
GOOGLE_API_KEY=            # Gemini (LLM + post-call analysis)
SARVAM_API_KEY=            # Sarvam saaras STT
# Google Cloud TTS (Chirp3-HD) — service account JSON, either a file path…
GOOGLE_APPLICATION_CREDENTIALS=gcp-service-account.json
# …or the JSON itself (used on Fly/Cloud Run where the file isn't shipped)
GCP_SERVICE_ACCOUNT_JSON=

# --- Public base URL of this deployment (used to show WS URLs on the dashboard) ---
PUBLIC_BASE_URL=https://gyan-tv-crm-glapp8.fly.dev

# --- Optional: outbound dialing via Exotel (Dial button on the dashboard) ---
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_SUBDOMAIN=api.exotel.com

# --- Optional: protect the dashboard/API with a shared token ---
DASHBOARD_TOKEN=

# --- Campaign: sheets → auto-dialer (share BOTH sheets with the service account email;
#     Editor on the user sheet so calls get logged to its call_log tab) ---
USER_SHEET=                # user activity sheet (URL or id), tab below, one row per user
USER_SHEET_TAB=user_queue
CALL_LOG_TAB=call_log
CONTENT_SHEET=             # content sheet (URL or id): Content ID, Video-Title, Category, [Script/Summary]
CONTENT_SHEET_TAB=         # blank = first tab
SYNC_EVERY_MINS=15
DIALER_ENABLED=0           # initial state; the dashboard toggle overrides it
CALL_WINDOW=10:00-19:00    # IST
MAX_CONCURRENT_CALLS=2
DIAL_GAP_SECS=20
MAX_ATTEMPTS=3             # dial attempts per contact
RETRY_AFTER_MINS=180       # wait between attempts after no answer
NO_ANSWER_AFTER_SECS=120   # dialed but never connected → counted as no answer
RECALL_AFTER_DAYS=30       # don't call the same number again within this

# --- Fillers: only for scripts/make_fillers.py --provider elevenlabs (one-time) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Admin panel (/admin): login password; unset = admin disabled ---
ADMIN_PASSWORD=
